generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(uuid())
  cretedAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  email String @unique
  password String
  name String?
}

model Admin {
  id String @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  email String @unique
  password String
  name String?
}

model Topic {
  id      String  @id @default(uuid())
  name    String
  words   Word[]
}

model Word {
  id        String    @id @default(uuid())
  word      String
  ipa       String?
  meaning   String?
  audioUrl  String?
  topicId   String?
  topic     Topic?    @relation(fields: [topicId], references: [id])
  examples  Example[]
}

model Example {
  id        String   @id @default(uuid())
  textEn    String
  textVi    String?
  wordId    String
  word      Word     @relation(fields: [wordId], references: [id])
  audioUrl  String?
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  email     String   @unique
  password  String
  name      String?
}

model Admin {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  email     String   @unique
  password  String
  name      String?
}

enum ProductType {
  product
  technology
}

model Product {
  id                   String                 @id @default(uuid())
  type                 ProductType
  name                 String
  image                String?
  description          String
  strengths            Json? // thế mạnh
  specifications       ProductSpecification[] @relation("ProductSpecifications") // Thông số kỹ thuật
  applicationScenarios ApplicationScenario[]  @relation("ProductApplicationScenarios") // Kịch bản ứng dụng
  features             ProductFeature[]       @relation("ProductFeatures") // Đặc tính sản phẩm
  slug                 String                 @unique
  relatedProducts      Product[]              @relation("RelatedProducts")
  relatedBy            Product[]              @relation("RelatedProducts")
  categoryId           String
  category             Category               @relation(fields: [categoryId], references: [id])
}

model ProductSpecification {
  id           String  @id @default(uuid())
  productId    String
  name         String
  image        String?
  descriptions Json? // [{ title?: string, description: string }]
  product      Product @relation("ProductSpecifications", fields: [productId], references: [id])
}

model ApplicationScenario {
  id           String  @id @default(uuid())
  productId    String
  name         String
  image        String?
  descriptions Json? // [{ title?: string, description: string }]
  product      Product @relation("ProductApplicationScenarios", fields: [productId], references: [id])
}

model ProductFeature {
  id           String  @id @default(uuid())
  productId    String
  name         String
  image        String?
  descriptions Json? // [{ title?: string, description: string }]
  product      Product @relation("ProductFeatures", fields: [productId], references: [id])
}

model Contact {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  name      String
  email     String
  phone     String
  jobTitle  String
  company   String
  country   String
  message   String?
}

model Category {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  name        String
  slug        String   @unique
  description String?
  logo_url    String?
  products    Product[]
}
